#!/bin/sh
# Project commit-msg hook.
# Strips any "Co-Authored-By: Claude ..." trailer from the commit message
# before the commit is finalized. Project preference: keep the git log free
# of AI-attribution boilerplate regardless of which tool generated the
# original message.
#
# Activate after cloning (one time per clone):
#   git config core.hooksPath .githooks
#
# The hook is silent on commits that contain no matching trailer.
sed -e '/^Co-Authored-By: Claude/d' "$1" > "$1.tmp" && mv "$1.tmp" "$1"
